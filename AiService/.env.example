# ==============================================================================
# Neha Hospitals AI Microservice - Environment Configuration Template
# ==============================================================================

# Server Network & Security
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_INTERNAL_KEY=neha-ai-internal-key-2026
AI_LOG_LEVEL=info

# Local Ollama Natural Language Understanding (NLU) & Dialogue Scribe
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_SECONDS=45

# Local Faster-Whisper Speech-to-Text (STT) Engine (100% On-Premise)
# Model size options: tiny, base, small, medium, large-v3 (default: small)
WHISPER_MODEL_SIZE=small

# Hardware Acceleration: auto (detects NVIDIA CUDA GPU / CPU), cuda, cpu
WHISPER_DEVICE=auto

# Precision: auto (float16 on GPU, int8 on CPU), float16, int8
WHISPER_COMPUTE_TYPE=auto

# Model storage cache directory
# WHISPER_CACHE_DIR=./models_cache/whisper
