# ==============================================================================
# Neha Hospital ERP — Root Environment Variables (.env)
# ==============================================================================

# ─── Frontend Build-Time Configuration ────────────────────────────────────────
VITE_API_URL=https://neha.tylo.co.in/api

# ─── Server & Application ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
WEB_ORIGIN=https://neha.tylo.co.in,http://localhost:8086,http://localhost:5173

# ─── MySQL Database Credentials ───────────────────────────────────────────────
DB_HOST=nehahospital-mysql
DB_PORT=3306
DB_USER=neha_user
DB_PASS=neha_password
DB_NAME=nehahospitals
DB_CA_CERT=
DB_SSL=false

# ─── MySQL Container Initialization ──────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=nehahospitals
MYSQL_USER=neha_user
MYSQL_PASSWORD=neha_password

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=4f59beb64dedad712f0ab2cfd455a1a98997bb6f167a605e1e474c1ddd6e2e361068033ff05bf075b2c9a3c798518b0c4035458ecd4637a65f21f89c9a65c76a
JWT_REFRESH_TOKEN=52382e23887684704eadaced2daef0862acaef97afb6cc3d98467254767538f32c4b5871a9724b83823677f0c79084f97d56b03e38499177127e0f7a543020bf
JWT_EXPIRES_IN=24h
PROTECTED_ROUTES_ENABLED=true

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15

# ─── eSSL Biometric Attendance Device (Local Network) ─────────────────────────
ESSL_DEVICE_IP=192.168.1.201
ESSL_DEVICE_PORT=4370
ESSL_DEVICE_COMM_KEY=0
ESSL_DEVICE_NAME="eSSL Main Entrance"
ESSL_DEVICE_LOCATION="Main Entrance Reception"
ESSL_AUTO_SYNC_ENABLED=true
ESSL_AUTO_SYNC_INTERVAL_MINS=15
