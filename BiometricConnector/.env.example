# Biometric Connector Edge Microservice Configuration
PORT=8000

# Public Tunnel / Domain (Mapped via Cloudflare Tunnel)
PUBLIC_URL=https://neha-bio.tylo.co.in

# Security API Key (Required for external requests from Cloud Backend)
# Pass this in the header: x-api-key: your-secure-connector-key
CONNECTOR_API_KEY=neha_bio_secret_key_2026

# Central Neha Hospitals Cloud Backend API
# Used when connector auto-pushes punch records to the main backend
MAIN_BACKEND_URL=https://api.yourhospital.com
MAIN_BACKEND_API_KEY=

# Auto-sync interval in minutes (0 to disable automatic background pull & push)
AUTO_SYNC_INTERVAL_MINS=10

# Default Primary Biometric Device (eSSL / ZKTeco on local LAN)
DEFAULT_DEVICE_NAME="Main Entrance Reception"
DEFAULT_DEVICE_IP=192.168.1.201
DEFAULT_DEVICE_PORT=4370
DEFAULT_DEVICE_COMM_KEY=0
DEFAULT_DEVICE_LOCATION="Main Entrance"

# Optional: Multi-Device JSON Configuration
# Example:
# DEVICES_CONFIG='[{"id":"dev-1","name":"Main Reception","ip":"192.168.1.201","port":4370},{"id":"dev-2","name":"Emergency / ICU","ip":"192.168.1.202","port":4370}]'
if another biometric is added in web page(`Biomtric Devices & Sync` page), biomtric connector should connect to that new device also