# ==============================================================================
# Neha Hospital ERP — Local Docker Desktop Environment (.env.local)
# Dedicated environment configuration for local developer testing
# ==============================================================================

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
TZ=Asia/Kolkata

# ─── Frontend & CORS ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5006/api
WEB_ORIGIN=http://localhost:8086,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8086

# ─── MySQL Local Container Credentials ────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=nehahospitals
CONTROL_PLANE_DB_NAME=control_plane_db
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASS=rootpassword
DB_NAME=nehahospitals
DB_SSL=false

# ─── Multi-Tenant Control Plane Configuration ────────────────────────────────
ENABLE_CONTROL_PLANE=true
IS_CONTROL_PLANE_ENABLED=true

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=4f59beb64dedad712f0ab2cfd455a1a98997bb6f167a605e1e474c1ddd6e2e361068033ff05bf075b2c9a3c798518b0c4035458ecd4637a65f21f89c9a65c76a
JWT_REFRESH_TOKEN=52382e23887684704eadaced2daef0862acaef97afb6cc3d98467254767538f32c4b5871a9724b83823677f0c79084f97d56b03e38499177127e0f7a543020bf
JWT_EXPIRES_IN=24h
PROTECTED_ROUTES_ENABLED=true

# ─── Rate Limiting (Relaxed for Local Testing) ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=50000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=500

# ─── AI Microservice Integration ──────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8000
AI_INTERNAL_KEY=neha-ai-internal-key-2026
